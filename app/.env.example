# Copia este archivo como .env y completa con los datos de tu proyecto
# (Supabase → tu proyecto → botón "Connect" o Project Settings → API Keys).
# Usa la llave PUBLISHABLE (sb_publishable_...) o la "anon" legacy. NUNCA la service_role / secret.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
